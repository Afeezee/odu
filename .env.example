# Neon Postgres connection string (must include ?sslmode=require)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY="gsk_..."

# Shared secret. During sign-up, a user who enters this string in the
# "admin secret" field is granted the admin role. Also protects the raw
# /api/admin/ingest endpoint if called without a session cookie.
ADMIN_SECRET="change-me-to-a-long-random-string"

# HMAC secret for signing session cookies. Must be at least 24 characters.
# Generate with:  openssl rand -base64 48
SESSION_SECRET="change-me-to-at-least-24-characters-of-random"

# Comma-separated list of emails that are ALWAYS granted the admin role,
# regardless of the ADMIN_SECRET flow. Useful for the project owner's own
# account. Case-insensitive, whitespace-trimmed.
ADMIN_EMAILS="olagunjuafeez@gmail.com"
